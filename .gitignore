# ─── Secrets (never commit) ───────────────────────────
.env
.env.local
.env.*.local
# Keep .env.example templates tracked.

# ─── Python ───────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ─── Databases (created at runtime by init_db) ────────
*.db
*.db-journal
*.sqlite
*.sqlite3

# ─── Logs ─────────────────────────────────────────────
*.log
backendserver.err.log
backendserver.out.log

# ─── Node / Next (frontend/.gitignore also covers these) ──
node_modules/
.next/
out/
build/
dist/

# ─── Tooling / skill artifacts ────────────────────────
.hallmark/
.superpowers/

# ─── OS ───────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Editor / local settings ──────────────────────────
.vscode/
.idea/
.claude/
*.swp
